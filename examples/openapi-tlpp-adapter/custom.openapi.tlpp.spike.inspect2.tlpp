#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
Spike: o spike anterior (custom.openapi.tlpp.spike.inspect.tlpp) revelou que cada item de
Reflection.getFunctionsByAnnotation('Get') e um Array (ValType 'A'), nao um Object -
Reflection.getDataValue falhou porque esperava objeto. Este fonte dumpa a estrutura interna
(tamanho e ValType/valor de cada posicao) dos 3 primeiros itens retornados, para descobrir o
layout posicional real (provavel [cFunctionName, cSourceName, ...] ou similar).
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/inspect2",;
    title="Spike Reflection - layout posicional do array retornado",;
    description="Dumpa tamanho e ValType/valor de cada posicao dos 3 primeiros itens de getFunctionsByAnnotation('Get').";
)
User Function TlaSpkIn2() as Logical

    Local aFuncs    := {} as Array
    Local jResp     := JsonObject():New() as Json
    Local cResp     := "" as Character
    Local lOk       := .F. as Logical
    Local cErro     := "" as Character
    Local aItens    := {} as Array
    Local jItem     := JsonObject():New() as Json
    Local aPos      := {} as Array
    Local jPos      := JsonObject():New() as Json
    Local nI        := 0 as Numeric
    Local nJ        := 0 as Numeric
    Local nLimite   := 0 as Numeric
    Local xValor    as Variant
    Local cValType  := "" as Character

    Try
        aFuncs := Reflection.getFunctionsByAnnotation("Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["success"]     := lOk
    jResp["resultCount"] := Len(aFuncs)

    If !lOk
        jResp["error"] := cErro
        jResp["items"] := aItens
        cResp := jResp:ToJson()
        oRest:SetStatusCode(200)
        oRest:SetKeyHeaderResponse("Content-Type", "application/json")
        Return oRest:SetResponse(cResp)
    EndIf

    nLimite := Len(aFuncs)
    If nLimite > 3
        nLimite := 3
    EndIf

    For nI := 1 To nLimite

        aPos := {}

        If ValType(aFuncs[nI]) == "A"

            For nJ := 1 To Len(aFuncs[nI])
                xValor := aFuncs[nI][nJ]
                cValType := ValType(xValor)

                jPos := JsonObject():New()
                jPos["position"] := nJ
                jPos["valType"]  := cValType

                If cValType == "C" .Or. cValType == "N" .Or. cValType == "L"
                    jPos["value"] := xValor
                ElseIf cValType == "A"
                    jPos["arrayLen"] := Len(xValor)
                ElseIf cValType == "O"
                    Try
                        jPos["className"] := xValor:ClassName()
                    Catch oException
                        jPos["classNameError"] := oException:description
                    EndTry
                EndIf

                AAdd(aPos, jPos)
            Next nJ

        EndIf

        jItem := JsonObject():New()
        jItem["itemValType"] := ValType(aFuncs[nI])
        jItem["itemLen"]     := Len(aFuncs[nI])
        jItem["positions"]   := aPos

        AAdd(aItens, jItem)

    Next nI

    jResp["items"] := aItens
    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
