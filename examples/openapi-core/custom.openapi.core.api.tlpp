#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

using namespace custom.openapi.core

/*/{Protheus.doc} OApiCore
    Publica o documento OpenAPI do exemplo Hello World gerado pelo núcleo TL++.
    @type function
    @author Dirlei Silva
    @since 2026-08-25
    @return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/core",;
    title="Documento OpenAPI do núcleo",;
    description="Retorna o documento OpenAPI gerado pelo núcleo TL++.",;
    responses='[{"statusCode":200,"description":"Documento OpenAPI retornado com sucesso."},{"statusCode":500,"description":"Falha ao gerar o documento OpenAPI."}]';
)
User Function OApiCore() as Logical

    Local oInfo         as Object
    Local oDoc          as Object
    Local oJson          as Object
    Local oSchHelloReq   as Object
    Local oSchHelloResp  as Object
    Local oSchError      as Object
    Local oParamName     as Object
    Local oParamLang     as Object
    Local oGet           as Object
    Local oRespGet       as Object
    Local oSchRefGet     as Object
    Local oPost          as Object
    Local oSchRefBody    as Object
    Local oRespPost200   as Object
    Local oSchRefPost200 as Object
    Local oRespPost400   as Object
    Local oSchRefPost400 as Object
    Local oPathHello     as Object
    Local jError as Json
    Local cResp := "" as Character

    Try
        oInfo := OApiInfo():new(;
            "Hello World API",;
            "API de demonstração do núcleo OpenAPI.",;
            "1.0.0";
        )
        oDoc := OApiDoc():new(oInfo)

        oSchHelloReq := OApiSchema():new("object")
        oSchHelloReq:addProp("name", OApiSchema():new("string"), .T.)
        oSchHelloReq:addProp("language", OApiSchema():new("string"), .F.)
        oDoc:addSchema("HelloRequest", oSchHelloReq)

        oSchHelloResp := OApiSchema():new("object")
        oSchHelloResp:addProp("message", OApiSchema():new("string"), .T.)
        oSchHelloResp:addProp("language", OApiSchema():new("string"), .T.)
        oSchHelloResp:addProp("status", OApiSchema():new("string"), .T.)
        oDoc:addSchema("HelloResponse", oSchHelloResp)

        oSchError := OApiSchema():new("object")
        oSchError:addProp("message", OApiSchema():new("string"), .T.)
        oSchError:addProp("status", OApiSchema():new("string"), .T.)
        oDoc:addSchema("ErrorResponse", oSchError)

        oParamName := OApiParam():new("name", "path", .T., OApiSchema():new("string"), "Nome usado na saudação.")
        oParamLang := OApiParam():new("language", "query", .F., OApiSchema():new("string"), "Idioma da saudação.")
        oGet := OApiOper():new(;
            "GET",;
            "Hello World",;
            "Retorna uma saudação personalizada usando o parâmetro de path name e o parâmetro opcional de query language.";
        )
        oGet:addParam(oParamName)
        oGet:addParam(oParamLang)
        oRespGet := OApiResp():new("200", "Saudação retornada com sucesso.")
        oSchRefGet := OApiSchema():new("ref")
        oSchRefGet:setRef("HelloResponse")
        oRespGet:setSchema(oSchRefGet)
        oGet:addResp(oRespGet)

        oPost := OApiOper():new("POST", "Cria saudação", "Cria uma nova saudação a partir de um HelloRequest.")
        oSchRefBody := OApiSchema():new("ref")
        oSchRefBody:setRef("HelloRequest")
        oPost:setBody(OApiBody():new(.T., oSchRefBody, "Dados para gerar a saudação."))
        oRespPost200 := OApiResp():new("200", "Saudação criada com sucesso.")
        oSchRefPost200 := OApiSchema():new("ref")
        oSchRefPost200:setRef("HelloResponse")
        oRespPost200:setSchema(oSchRefPost200)
        oPost:addResp(oRespPost200)
        oRespPost400 := OApiResp():new("400", "Payload inválido.")
        oSchRefPost400 := OApiSchema():new("ref")
        oSchRefPost400:setRef("ErrorResponse")
        oRespPost400:setSchema(oSchRefPost400)
        oPost:addResp(oRespPost400)

        oPathHello := OApiPath():new("/api/v1/hello")
        oPathHello:addOper(oGet)
        oPathHello:addOper(oPost)
        oDoc:addPath(oPathHello)

        oJson := OApiJson():new()
        cResp := oJson:toJson(oDoc)
        oRest:SetStatusCode(200)
    Catch oError
        jError := JsonObject():New()
        jError["success"] := .F.
        jError["message"] := "Falha ao gerar o documento OpenAPI."
        cResp := jError:ToJson()
        oRest:SetStatusCode(500)
    EndTry

    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
