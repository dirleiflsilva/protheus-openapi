#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
Spike: Reflection.getFunctionsByAnnotation('Get') ja confirmou 295 resultados reais no
ambiente P12_2510 (spike anterior, custom.openapi.tlpp.spike.enum.tlpp), mas o formato de
cada elemento ainda nao e conhecido. Este fonte inspeciona o primeiro elemento retornado:
tipo (ValType), classe (ClassName) quando aplicavel, e tenta ler dinamicamente varios nomes
de propriedade candidatos via Reflection.getDataValue (ja confirmado em codigo real de
producao), sem assumir qual deles existe de fato.
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/inspect",;
    title="Spike Reflection - inspecao do retorno de getFunctionsByAnnotation",;
    description="Inspeciona tipo, classe e propriedades candidatas do primeiro item retornado por getFunctionsByAnnotation('Get').";
)
User Function TlaSpkIns() as Logical

    Local aFuncs        := {} as Array
    Local jResp          := JsonObject():New() as Json
    Local cResp          := "" as Character
    Local lOk            := .F. as Logical
    Local cErro          := "" as Character
    Local oFirst         as Object
    Local cValType       := "" as Character
    Local cClassName     := "" as Character
    Local aCandidatos    := {} as Array
    Local aProps         := {} as Array
    Local nI             := 0 as Numeric
    Local cNomeProp      := "" as Character
    Local xValor         as Variant
    Local jProp          := JsonObject():New() as Json

    Try
        aFuncs := Reflection.getFunctionsByAnnotation("Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["success"]    := lOk
    jResp["resultCount"] := Len(aFuncs)

    If !lOk
        jResp["error"] := cErro
        jResp["experiments"] := aProps
        cResp := jResp:ToJson()
        oRest:SetStatusCode(200)
        oRest:SetKeyHeaderResponse("Content-Type", "application/json")
        Return oRest:SetResponse(cResp)
    EndIf

    If Len(aFuncs) == 0
        jResp["experiments"] := aProps
        cResp := jResp:ToJson()
        oRest:SetStatusCode(200)
        oRest:SetKeyHeaderResponse("Content-Type", "application/json")
        Return oRest:SetResponse(cResp)
    EndIf

    oFirst := aFuncs[1]
    cValType := ValType(oFirst)
    jResp["firstValType"] := cValType

    Try
        cClassName := oFirst:ClassName()
        jResp["firstClassName"] := cClassName
    Catch oException
        jResp["firstClassNameError"] := oException:description
    EndTry

    aCandidatos := {;
        "cFunctionName", "cFuncName", "cName", "cMethodName",;
        "cSourceName", "cSource", "cFileName", "cModuleName",;
        "cAnnotationName", "cEndpoint", "cPath", "cVerb",;
        "cHttpMethod", "aParameters", "aAttributes", "aParams";
    }

    For nI := 1 To Len(aCandidatos)
        cNomeProp := aCandidatos[nI]
        xValor := Nil
        lOk := .F.
        cErro := ""

        Try
            xValor := Reflection.getDataValue(oFirst, cNomeProp)
            lOk := .T.
        Catch oException
            lOk := .F.
            cErro := oException:description
        EndTry

        jProp := JsonObject():New()
        jProp["property"] := cNomeProp
        jProp["success"]  := lOk

        If lOk
            jProp["valType"] := ValType(xValor)
            If ValType(xValor) == "C" .Or. ValType(xValor) == "N" .Or. ValType(xValor) == "L"
                jProp["value"] := xValor
            ElseIf ValType(xValor) == "A"
                jProp["arrayLen"] := Len(xValor)
            EndIf
        Else
            jProp["error"] := cErro
        EndIf

        AAdd(aProps, jProp)
    Next nI

    jResp["experiments"] := aProps
    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
