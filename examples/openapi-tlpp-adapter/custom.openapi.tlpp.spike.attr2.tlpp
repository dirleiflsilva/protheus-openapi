#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
Spike: o Language Server acusou "Too few parameters" para uma tentativa inicial de 2
argumentos em Reflection.isAnnotationFunctionPresent e Reflection.getFunctionAnnotation,
confirmando estaticamente que as duas funcoes existem, mas exigem mais argumentos (ver
custom.openapi.tlpp.spike.attr3.tlpp para a hipotese de 3 argumentos ja aceita pelo
Language Server para getFunctionAnnotation). Este fonte testa duas hipoteses adicionais
de cSourceName para isAnnotationFunctionPresent, ja com 3 argumentos.
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/attr2",;
    title="Spike Reflection - hipoteses de cSourceName",;
    description="Tenta isAnnotationFunctionPresent com duas hipoteses distintas de cSourceName, ja com 3 argumentos.";
)
User Function TlaSpkAt2() as Logical

    Local jResp     := JsonObject():New() as Json
    Local aExp      := {} as Array
    Local jExp      := JsonObject():New() as Json
    Local cResp     := "" as Character
    Local lOk       := .F. as Logical
    Local cErro     := "" as Character
    Local lPresente := .F. as Logical

    Try
        lPresente := Reflection.isAnnotationFunctionPresent("custom.openapi.hello.get", "HeloGet", "Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jExp := JsonObject():New()
    jExp["experiment"] := "Reflection.isAnnotationFunctionPresent('custom.openapi.hello.get', 'HeloGet', 'Get')"
    jExp["success"]    := lOk
    If lOk
        jExp["result"] := lPresente
    Else
        jExp["error"] := cErro
    EndIf
    AAdd(aExp, jExp)

    lOk       := .F.
    cErro     := ""
    lPresente := .F.

    Try
        lPresente := Reflection.isAnnotationFunctionPresent("HeloGet", "HeloGet", "Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jExp := JsonObject():New()
    jExp["experiment"] := "Reflection.isAnnotationFunctionPresent('HeloGet', 'HeloGet', 'Get')"
    jExp["success"]    := lOk
    If lOk
        jExp["result"] := lPresente
    Else
        jExp["error"] := cErro
    EndIf
    AAdd(aExp, jExp)

    jResp["experiments"] := aExp
    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
