#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
Spike: tenta enumerar todas as funcoes anotadas com @Get via Reflection.getFunctionsByAnnotation,
API descrita no TDN mas ainda nao confirmada por codigo real compilavel neste projeto (nenhuma
ocorrencia encontrada nas arvores padrao locais). Reporta sucesso/erro em vez de assumir o resultado.
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/enum",;
    title="Spike Reflection - enumeracao por funcao",;
    description="Tenta Reflection.getFunctionsByAnnotation('Get') e reporta sucesso ou erro.";
)
User Function TlaSpkEnu() as Logical

    Local aFuncs    := {} as Array
    Local jResp     := JsonObject():New() as Json
    Local cResp     := "" as Character
    Local lOk       := .F. as Logical
    Local cErro     := "" as Character

    Try
        aFuncs := Reflection.getFunctionsByAnnotation("Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["experiment"]  := "Reflection.getFunctionsByAnnotation('Get')"
    jResp["success"]     := lOk
    jResp["resultCount"] := Len(aFuncs)

    If !lOk
        jResp["error"] := cErro
    EndIf

    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
