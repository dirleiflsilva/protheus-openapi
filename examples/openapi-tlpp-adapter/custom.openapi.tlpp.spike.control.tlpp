#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

@annotation TlaSpike
    label as character default ""
@end

/*/{Protheus.doc} TlaSpkObj
Classe descartavel usada apenas pelo spike de verificacao da API de reflection (Fase 3 do roadmap).
Existe somente para decorar uma propriedade com uma annotation propria e comprovar que o
namespace Reflection resolve neste AppServer, usando o mesmo padrao ja confirmado em codigo real
de producao (backoffice.fiscal.arquivos.utils.tlpp).
@type class
@author Dirlei Silva
@since 2026-09-25
/*/
Class TlaSpkObj

    @TlaSpike(label = "campoTeste")
    Data cCampo as Character

    Public Method new() Constructor

EndClass

Method new() Class TlaSpkObj
    ::cCampo := "valor-exemplo"
Return Self

/*/{Protheus.doc}
Spike de controle: reaplica o padrao confirmado em codigo real de producao
(Reflection.getAttributesByAnnotation / isAnnotationDataPresent / getDataAnnotation)
sobre uma propriedade de objeto, para confirmar que o namespace Reflection resolve
neste AppServer antes de testar as variantes de funcao (ainda nao confirmadas).
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/control",;
    title="Spike Reflection - controle",;
    description="Confirma se Reflection.* resolve neste AppServer usando o padrao de annotation de dado ja confirmado em codigo real de producao.";
)
User Function TlaSpkCtl() as Logical

    Local oObj      := TlaSpkObj():New() as Object
    Local aFields   := {} as Array
    Local jResp     := JsonObject():New() as Json
    Local cResp     := "" as Character
    Local lOk       := .F. as Logical
    Local cErro     := "" as Character

    Try
        aFields := Reflection.getAttributesByAnnotation(oObj, "TlaSpike")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["experiment"]  := "Reflection.getAttributesByAnnotation(oObj, 'TlaSpike')"
    jResp["success"]     := lOk
    jResp["resultCount"] := Len(aFields)

    If !lOk
        jResp["error"] := cErro
    EndIf

    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
