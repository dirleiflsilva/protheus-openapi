#include "tlpp-core.th"
#include "tlpp-probat.th"
#include "totvs.ch"

namespace custom.openapi.core.test

using namespace tlpp.probat
using namespace custom.openapi.core

/*/{Protheus.doc}
    Valida o harness mínimo do PROBAT e os contratos iniciais do núcleo OpenAPI.

    @type function
    @author Dirlei Silva
    @since 2026-08-24
    @return logical, Resultado dos testes do núcleo OpenAPI
    @example
        Executar o fixture OApiTst pelo PROBAT.
*/
@TestFixture()
User Function OApiTst() as Logical

    Local oInfo    as Object
    Local oInv     as Object
    Local oResp    as Object
    Local oRInv    as Object
    Local oOper    as Object
    Local oNoResp  as Object
    Local oDupResp as Object
    Local oNextRsp as Object
    Local oVerb    as Object
    Local oPath    as Object
    Local oBadPath as Object
    Local oDupOper as Object
    Local oPost    as Object
    Local oPostRsp as Object
    Local oPendP   as Object
    Local oPendOp  as Object
    Local oDoc     as Object
    Local oBadDoc  as Object
    Local oBadInfo as Object
    Local oPendDoc as Object
    Local oDupPath as Object
    Local oUniPath as Object
    Local oUniOper as Object
    Local oUniResp as Object
    Local oInvResp as Object
    Local oInvOper as Object
    Local oInvPath as Object
    Local oInvDoc  as Object
    Local oMultiDoc as Object
    Local oJson    as Object
    Local oJInfo   as Object
    Local oJResp   as Object
    Local oJBad    as Object
    Local oJOper   as Object
    Local oJPost   as Object
    Local oJPResp  as Object
    Local oJPath   as Object
    Local oJStat   as Object
    Local oJSOper  as Object
    Local oJSResp  as Object
    Local jParsed  as Json
    Local aValid  := {} as Array
    Local aPend   := {} as Array
    Local aRValid := {} as Array
    Local aRPend  := {} as Array
    Local aResps  := {} as Array
    Local aOPend  := {} as Array
    Local aOpers  := {} as Array
    Local aPPend  := {} as Array
    Local aPaths  := {} as Array
    Local aDValid := {} as Array
    Local aDInv   := {} as Array
    Local aDPend  := {} as Array
    Local aInvPend := {} as Array
    Local aMulti   := {} as Array
    Local aVerbs  := {{"GET", "get"}, {"PUT", "put"}, {"POST", "post"}, {"DELETE", "delete"}, {"OPTIONS", "options"}, {"HEAD", "head"}, {"PATCH", "patch"}, {"TRACE", "trace"}} as Array
    Local cBadVerb := "" as Character
    Local cDupErr  := "" as Character
    Local cPathErr := "" as Character
    Local cDupOper := "" as Character
    Local cDupPath := "" as Character
    Local cJson    := "" as Character
    Local cJsonErr := "" as Character
    Local cParse   := "" as Character
    Local lBadVerb := .F. as Logical
    Local lDupErr  := .F. as Logical
    Local lPathErr := .F. as Logical
    Local lDupOper := .F. as Logical
    Local lDupPath := .F. as Logical
    Local lJsonErr := .F. as Logical
    Local nVerb    := 0 as Numeric

    assertEquals(.T., .T., "O harness PROBAT deve aceitar valores iguais.")

    oInfo := OApiInfo():new(;
        "Hello World API",;
        "API de demonstração do núcleo OpenAPI.",;
        "1.0.0";
    )

    assertEquals("Hello World API", oInfo:getTitle(), "O título deve ser preservado.")
    assertEquals("API de demonstração do núcleo OpenAPI.", oInfo:getDesc(), "A descrição deve ser preservada.")
    assertEquals("1.0.0", oInfo:getVer(), "A versão deve ser preservada.")

    aValid := oInfo:validate()
    assertEquals(0, Len(aValid), "Informações válidas não devem gerar pendências.")

    oInv  := OApiInfo():new("", "Descrição opcional.", "")
    aPend := oInv:validate()

    assertEquals(2, Len(aPend), "Título e versão vazios devem gerar duas pendências.")

    If Len(aPend) >= 2
        assertEquals("Título da API é obrigatório.", aPend[1], "A pendência do título deve ocupar a primeira posição.")
        assertEquals("Versão da API é obrigatória.", aPend[2], "A pendência da versão deve ocupar a segunda posição.")
    EndIf

    oResp := OApiResp():new("200", "Resposta retornada com sucesso.")

    assertEquals("200", oResp:getCode(), "O código da resposta deve ser preservado.")
    assertEquals("Resposta retornada com sucesso.", oResp:getDesc(), "A descrição da resposta deve ser preservada.")

    aRValid := oResp:validate()
    assertEquals(0, Len(aRValid), "Resposta válida não deve gerar pendências.")

    oRInv  := OApiResp():new("", "")
    aRPend := oRInv:validate()

    assertEquals(2, Len(aRPend), "Código e descrição vazios devem gerar duas pendências.")

    If Len(aRPend) >= 2
        assertEquals("Código da resposta é obrigatório.", aRPend[1], "A pendência do código deve ocupar a primeira posição.")
        assertEquals("Descrição da resposta é obrigatória.", aRPend[2], "A pendência da descrição deve ocupar a segunda posição.")
    EndIf

    oOper := OApiOper():new(;
        "GET",;
        "Retorna a saudação",;
        "Retorna a resposta Hello World.";
    )

    assertEquals("get", oOper:getMethod(), "O verbo suportado deve ser normalizado para minúsculas.")
    assertEquals("Retorna a saudação", oOper:getSummary(), "O resumo da operação deve ser preservado.")
    assertEquals("Retorna a resposta Hello World.", oOper:getDesc(), "A descrição da operação deve ser preservada.")

    For nVerb := 1 To Len(aVerbs)
        oVerb := OApiOper():new(aVerbs[nVerb][1], "Operação de teste", "Valida um verbo OpenAPI.")
        assertEquals(aVerbs[nVerb][2], oVerb:getMethod(), "O verbo " + aVerbs[nVerb][1] + " deve ser aceito e normalizado.")
    Next nVerb

    oOper:addResp(oResp)
    aResps := oOper:getResps()

    assertEquals(1, Len(aResps), "A resposta 200 deve ser incluída na operação.")
    If Len(aResps) >= 1
        assertEquals("200", aResps[1]:getCode(), "O código da resposta incluída deve ser preservado.")
        assertEquals("Resposta retornada com sucesso.", aResps[1]:getDesc(), "A resposta original deve ser preservada.")
    EndIf
    oNextRsp := OApiResp():new("201", "Recurso criado com sucesso.")
    AAdd(aResps, oNextRsp)
    assertEquals(2, Len(aResps), "O array retornado deve aceitar alteração externa isolada.")

    aResps := oOper:getResps()
    assertEquals(1, Len(aResps), "A alteração externa não deve modificar as respostas internas.")
    If Len(aResps) >= 1
        assertEquals("200", aResps[1]:getCode(), "Uma nova consulta deve preservar somente a resposta interna.")
    EndIf

    assertEquals(0, Len(oOper:validate()), "Operação com resposta válida não deve gerar pendências.")

    oNoResp := OApiOper():new("POST", "Cria um recurso", "Cria um recurso de teste.")
    aOPend := oNoResp:validate()

    assertEquals(1, Len(aOPend), "Operação sem respostas deve gerar uma pendência.")
    If Len(aOPend) >= 1
        assertEquals("Operação post sem respostas.", aOPend[1], "A pendência deve identificar o verbo normalizado.")
    EndIf

    Try
        oNoResp := OApiOper():new("CONNECT", "Verbo inválido", "Não deve ser criado.")
    Catch oError
        lBadVerb := .T.
        cBadVerb := oError:Description
    EndTry

    assertEquals(.T., lBadVerb, "Verbo desconhecido deve falhar imediatamente.")
    assertEquals("Verbo OpenAPI não suportado: CONNECT.", cBadVerb, "O erro deve diagnosticar o verbo desconhecido.")

    oDupResp := OApiResp():new("200", "Resposta que não deve substituir a original.")

    Try
        oOper:addResp(oDupResp)
    Catch oError
        lDupErr := .T.
        cDupErr := oError:Description
    EndTry

    assertEquals(.T., lDupErr, "Resposta duplicada deve falhar imediatamente.")
    assertEquals("Resposta duplicada: 200.", cDupErr, "O erro deve diagnosticar o código duplicado.")

    aResps := oOper:getResps()
    assertEquals(1, Len(aResps), "A falha não deve incluir nem substituir a resposta original.")
    If Len(aResps) >= 1
        assertEquals("Resposta retornada com sucesso.", aResps[1]:getDesc(), "A resposta original deve permanecer inalterada.")
    EndIf

    oOper:addResp(oNextRsp)
    aResps := oOper:getResps()

    assertEquals(2, Len(aResps), "A operação deve continuar utilizável após a inclusão rejeitada.")
    If Len(aResps) >= 2
        assertEquals("201", aResps[2]:getCode(), "Uma nova resposta válida deve ser aceita após a falha.")
    EndIf

    oPath := OApiPath():new("/api/v1/hello")
    assertEquals("/api/v1/hello", oPath:getPath(), "O path deve ser preservado.")

    oPath:addOper(oOper)
    aOpers := oPath:getOpers()

    assertEquals(1, Len(aOpers), "A operação GET válida deve ser incluída no path.")
    If Len(aOpers) >= 1
        assertEquals("get", aOpers[1]:getMethod(), "O verbo da operação incluída deve ser preservado.")
        assertEquals("Retorna a saudação", aOpers[1]:getSummary(), "O resumo da primeira operação deve ser preservado.")
    EndIf

    oDupOper := OApiOper():new("GET", "Resumo duplicado", "Não deve substituir a operação original.")
    AAdd(aOpers, oDupOper)
    assertEquals(2, Len(aOpers), "O array retornado deve aceitar alteração externa isolada.")

    aOpers := oPath:getOpers()
    assertEquals(1, Len(aOpers), "A alteração externa não deve modificar as operações internas.")

    Try
        oBadPath := OApiPath():new("api/v1/hello")
    Catch oError
        lPathErr := .T.
        cPathErr := oError:Description
    EndTry

    assertEquals(.T., lPathErr, "Path sem barra inicial deve falhar imediatamente.")
    assertEquals("Path OpenAPI inválido: api/v1/hello.", cPathErr, "O erro deve diagnosticar o path inválido.")

    Try
        oPath:addOper(oDupOper)
    Catch oError
        lDupOper := .T.
        cDupOper := oError:Description
    EndTry

    assertEquals(.T., lDupOper, "Verbo duplicado no mesmo path deve falhar imediatamente.")
    assertEquals("Operação duplicada no path /api/v1/hello: get.", cDupOper, "O erro deve identificar o path e o verbo duplicado.")

    aOpers := oPath:getOpers()
    assertEquals(1, Len(aOpers), "A falha não deve incluir nem substituir a operação original.")
    If Len(aOpers) >= 1
        assertEquals("Retorna a saudação", aOpers[1]:getSummary(), "A operação original deve permanecer inalterada.")
    EndIf

    oPost := OApiOper():new("POST", "Cria uma saudação", "Cria uma nova saudação.")
    oPostRsp := OApiResp():new("201", "Saudação criada com sucesso.")
    oPost:addResp(oPostRsp)
    oPath:addOper(oPost)
    aOpers := oPath:getOpers()

    assertEquals(2, Len(aOpers), "O path deve continuar utilizável após a inclusão rejeitada.")
    If Len(aOpers) >= 2
        assertEquals("post", aOpers[2]:getMethod(), "Uma nova operação válida deve ser aceita após a falha.")
    EndIf

    assertEquals(0, Len(oPath:validate()), "Path com operações válidas não deve gerar pendências.")

    oPendP := OApiPath():new("/api/v1/pending")
    oPendOp := OApiOper():new("POST", "Operação pendente", "Operação sem resposta.")
    oPendP:addOper(oPendOp)
    aPPend := oPendP:validate()

    assertEquals(1, Len(aPPend), "Path com operação incompleta deve agregar uma pendência.")
    If Len(aPPend) >= 1
        assertEquals("Path /api/v1/pending: Operação post sem respostas.", aPPend[1], "A pendência deve identificar o path e o verbo.")
    EndIf

    oDoc := OApiDoc():new(oInfo)

    assertEquals("3.0.3", oDoc:getOpenApi(), "A versão OpenAPI deve ser fixa em 3.0.3.")
    assertEquals("Hello World API", oDoc:getInfo():getTitle(), "As informações válidas devem ser preservadas no documento.")
    assertEquals("1.0.0", oDoc:getInfo():getVer(), "A versão da API deve ser preservada no documento.")

    oDoc:addPath(oPath)
    aPaths := oDoc:getPaths()

    assertEquals(1, Len(aPaths), "O path Hello World completo deve ser incluído no documento.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "O path incluído deve ser preservado.")
    EndIf

    AAdd(aPaths, oPendP)
    assertEquals(2, Len(aPaths), "O array retornado deve aceitar alteração externa isolada.")

    aPaths := oDoc:getPaths()
    assertEquals(1, Len(aPaths), "A alteração externa não deve modificar os paths internos.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "Uma nova consulta deve preservar somente o path interno.")
    EndIf

    oDupPath := OApiPath():new("/api/v1/hello")

    Try
        oDoc:addPath(oDupPath)
    Catch oError
        lDupPath := .T.
        cDupPath := oError:Description
    EndTry

    assertEquals(.T., lDupPath, "Path duplicado no documento deve falhar imediatamente.")
    assertEquals("Path duplicado no documento: /api/v1/hello.", cDupPath, "O erro deve identificar o path duplicado.")

    aPaths := oDoc:getPaths()
    assertEquals(1, Len(aPaths), "A falha não deve incluir nem substituir o path original.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "O path original deve permanecer inalterado.")
    EndIf

    oUniPath := OApiPath():new("/api/v1/unique")
    oUniOper := OApiOper():new("GET", "Consulta única", "Consulta um recurso único.")
    oUniResp := OApiResp():new("200", "Recurso único retornado com sucesso.")
    oUniOper:addResp(oUniResp)
    oUniPath:addOper(oUniOper)
    oDoc:addPath(oUniPath)
    aPaths := oDoc:getPaths()

    assertEquals(2, Len(aPaths), "O documento deve continuar utilizável após a inclusão rejeitada.")
    If Len(aPaths) >= 2
        assertEquals("/api/v1/unique", aPaths[2]:getPath(), "Um path único deve ser aceito após a falha.")
    EndIf

    aDValid := oDoc:validate()
    assertEquals(0, Len(aDValid), "Documento válido não deve gerar pendências.")

    oBadInfo := OApiInfo():new("", "", "")
    oBadDoc := OApiDoc():new(oBadInfo)
    aDInv := oBadDoc:validate()

    assertEquals(3, Len(aDInv), "Informações inválidas e ausência de paths devem gerar três pendências.")
    If Len(aDInv) >= 3
        assertEquals("Título da API é obrigatório.", aDInv[1], "A pendência do título deve ocupar a primeira posição.")
        assertEquals("Versão da API é obrigatória.", aDInv[2], "A pendência da versão deve ocupar a segunda posição.")
        assertEquals("Documento OpenAPI deve possuir ao menos um path.", aDInv[3], "A ausência de paths deve ocupar a terceira posição.")
    EndIf

    oPendDoc := OApiDoc():new(oInfo)
    oPendDoc:addPath(oPendP)
    aDPend := oPendDoc:validate()

    assertEquals(1, Len(aDPend), "Documento com path incompleto deve agregar uma pendência.")
    If Len(aDPend) >= 1
        assertEquals("Path /api/v1/pending: Operação post sem respostas.", aDPend[1], "A pendência do path deve manter o contexto no documento.")
    EndIf

    oInvResp := OApiResp():new("", "")
    oInvOper := OApiOper():new("GET", "Resposta inválida", "Valida pendências transitivas.")
    oInvOper:addResp(oInvResp)
    oInvPath := OApiPath():new("/api/v1/invalid")
    oInvPath:addOper(oInvOper)
    oInvDoc := OApiDoc():new(oInfo)
    oInvDoc:addPath(oInvPath)
    aInvPend := oInvDoc:validate()

    assertEquals(2, Len(aInvPend), "Documento deve agregar as duas pendências da resposta inválida.")
    If Len(aInvPend) >= 2
        assertEquals("Path /api/v1/invalid: Operação get, resposta <vazio>: Código da resposta é obrigatório.", aInvPend[1], "A primeira pendência deve manter o contexto completo da resposta.")
        assertEquals("Path /api/v1/invalid: Operação get, resposta <vazio>: Descrição da resposta é obrigatória.", aInvPend[2], "A segunda pendência deve manter o contexto completo da resposta.")
    EndIf

    oMultiDoc := OApiDoc():new(oInfo)
    oMultiDoc:addPath(oPendP)
    oMultiDoc:addPath(oInvPath)
    aMulti := oMultiDoc:validate()

    assertEquals(3, Len(aMulti), "Documento deve agregar pendências de todos os paths em ordem.")
    If Len(aMulti) >= 3
        assertEquals("Path /api/v1/pending: Operação post sem respostas.", aMulti[1], "A pendência do primeiro path deve ocupar a primeira posição.")
        assertEquals("Path /api/v1/invalid: Operação get, resposta <vazio>: Código da resposta é obrigatório.", aMulti[2], "A primeira pendência do segundo path deve ocupar a segunda posição.")
        assertEquals("Path /api/v1/invalid: Operação get, resposta <vazio>: Descrição da resposta é obrigatória.", aMulti[3], "A segunda pendência do segundo path deve ocupar a terceira posição.")
    EndIf

    oJson := OApiJson():new()

    Try
        cJson := oJson:toJson(oBadDoc)
    Catch oError
        lJsonErr := .T.
        cJsonErr := oError:Description
    EndTry

    assertEquals(.T., lJsonErr, "Documento incompleto deve ser rejeitado antes da serialização.")
    assertEquals("Documento OpenAPI inválido: Título da API é obrigatório. | Versão da API é obrigatória. | Documento OpenAPI deve possuir ao menos um path.", cJsonErr, "O erro deve agregar todas as pendências sem dados de ambiente.")
    assertEquals("", cJson, "Falha de validação não deve retornar JSON parcial.")

    oJInfo := OApiInfo():new(;
        "Hello World API",;
        "API de demonstração do núcleo OpenAPI.",;
        "1.0.0";
    )
    oJResp := OApiResp():new("200", "Hello World retornado com sucesso.")
    oJBad := OApiResp():new("400", "Requisição inválida.")
    oJOper := OApiOper():new(;
        "GET",;
        "Hello World",;
        "Retorna uma mensagem Hello World gerada por um endpoint TL++.";
    )
    oJOper:addResp(oJResp)
    oJOper:addResp(oJBad)
    oJPost := OApiOper():new("POST", "Cria saudação", "Cria uma nova saudação.")
    oJPResp := OApiResp():new("201", "Saudação criada com sucesso.")
    oJPost:addResp(oJPResp)
    oJPath := OApiPath():new("/api/v1/hello")
    oJPath:addOper(oJOper)
    oJPath:addOper(oJPost)
    oJStat := OApiPath():new("/api/v1/status")
    oJSOper := OApiOper():new("GET", "Consulta status", "Retorna o status da API.")
    oJSResp := OApiResp():new("200", "Status retornado com sucesso.")
    oJSOper:addResp(oJSResp)
    oJStat:addOper(oJSOper)
    oDoc := OApiDoc():new(oJInfo)
    oDoc:addPath(oJPath)
    oDoc:addPath(oJStat)

    cJson := oJson:toJson(oDoc)
    assertEquals("C", ValType(cJson), "A serialização válida deve retornar character.")
    assertEquals(.F., Empty(cJson), "A serialização válida deve retornar conteúdo JSON.")

    jParsed := JsonObject():New()
    cParse := jParsed:FromJson(cJson)
    assertEquals(.T., Empty(cParse), "O JSON produzido deve ser aceito por JsonObject:FromJson().")

    If Empty(cParse)
        assertEquals("3.0.3", jParsed["openapi"], "O JSON deve preservar a versão OpenAPI.")
        assertEquals("Hello World API", jParsed["info"]["title"], "O JSON deve preservar o título da API.")
        assertEquals("API de demonstração do núcleo OpenAPI.", jParsed["info"]["description"], "O JSON deve preservar a descrição da API.")
        assertEquals("1.0.0", jParsed["info"]["version"], "O JSON deve preservar a versão da API.")
        assertEquals("Hello World", jParsed["paths"]["/api/v1/hello"]["get"]["summary"], "O JSON deve preservar o resumo da operação GET.")
        assertEquals("Retorna uma mensagem Hello World gerada por um endpoint TL++.", jParsed["paths"]["/api/v1/hello"]["get"]["description"], "O JSON deve preservar a descrição da operação GET.")
        assertEquals("Hello World retornado com sucesso.", jParsed["paths"]["/api/v1/hello"]["get"]["responses"]["200"]["description"], "O JSON deve preservar a descrição da resposta 200.")
        assertEquals("Requisição inválida.", jParsed["paths"]["/api/v1/hello"]["get"]["responses"]["400"]["description"], "O JSON deve preservar a segunda resposta da operação GET.")
        assertEquals("Cria saudação", jParsed["paths"]["/api/v1/hello"]["post"]["summary"], "O JSON deve preservar a segunda operação do path Hello World.")
        assertEquals("Saudação criada com sucesso.", jParsed["paths"]["/api/v1/hello"]["post"]["responses"]["201"]["description"], "O JSON deve preservar a resposta 201 da operação POST.")
        assertEquals("Consulta status", jParsed["paths"]["/api/v1/status"]["get"]["summary"], "O JSON deve preservar a operação GET do segundo path.")
        assertEquals("Status retornado com sucesso.", jParsed["paths"]["/api/v1/status"]["get"]["responses"]["200"]["description"], "O JSON deve preservar a resposta 200 do segundo path.")
    EndIf

Return .T.
