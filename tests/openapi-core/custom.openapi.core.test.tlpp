#include "tlpp-core.th"
#include "tlpp-probat.th"
#include "totvs.ch"

namespace custom.openapi.core.test

using namespace tlpp.probat
using namespace custom.openapi.core

/*/{Protheus.doc}
    Valida o harness m?nimo do PROBAT e os contratos iniciais do n?cleo OpenAPI.

    @type function
    @author Dirlei Silva
    @since 2026-08-24
    @return logical, Resultado dos testes do n?cleo OpenAPI
    @example
        Executar o fixture OApiTst pelo PROBAT.
*/
@TestFixture()
User Function OApiTst() as Logical

    Local oInfo    as Object
    Local oInv     as Object
    Local oResp    as Object
    Local oRInv    as Object
    Local oOper    as Object
    Local oNoResp  as Object
    Local oDupResp as Object
    Local oNextRsp as Object
    Local oVerb    as Object
    Local oPath    as Object
    Local oBadPath as Object
    Local oDupOper as Object
    Local oPost    as Object
    Local oPostRsp as Object
    Local oPendP   as Object
    Local oPendOp  as Object
    Local oDoc     as Object
    Local oBadDoc  as Object
    Local oBadInfo as Object
    Local oPendDoc as Object
    Local oDupPath as Object
    Local oUniPath as Object
    Local oUniOper as Object
    Local oUniResp as Object
    Local oInvResp as Object
    Local oInvOper as Object
    Local oInvPath as Object
    Local oInvDoc  as Object
    Local oMultiDoc as Object
    Local oJson    as Object
    Local oJInfo   as Object
    Local oJResp   as Object
    Local oJBad    as Object
    Local oJOper   as Object
    Local oJPost   as Object
    Local oJPResp  as Object
    Local oJPath   as Object
    Local oJStat   as Object
    Local oJSOper  as Object
    Local oJSResp  as Object
    Local jParsed  as Json
    Local aValid  := {} as Array
    Local aPend   := {} as Array
    Local aRValid := {} as Array
    Local aRPend  := {} as Array
    Local aResps  := {} as Array
    Local aOPend  := {} as Array
    Local aOpers  := {} as Array
    Local aPPend  := {} as Array
    Local aPaths  := {} as Array
    Local aDValid := {} as Array
    Local aDInv   := {} as Array
    Local aDPend  := {} as Array
    Local aInvPend := {} as Array
    Local aMulti   := {} as Array
    Local aVerbs  := {{"GET", "get"}, {"PUT", "put"}, {"POST", "post"}, {"DELETE", "delete"}, {"OPTIONS", "options"}, {"HEAD", "head"}, {"PATCH", "patch"}, {"TRACE", "trace"}} as Array
    Local cBadVerb := "" as Character
    Local cDupErr  := "" as Character
    Local cPathErr := "" as Character
    Local cDupOper := "" as Character
    Local cDupPath := "" as Character
    Local cJson    := "" as Character
    Local cJsonErr := "" as Character
    Local cParse   := "" as Character
    Local lBadVerb := .F. as Logical
    Local lDupErr  := .F. as Logical
    Local lPathErr := .F. as Logical
    Local lDupOper := .F. as Logical
    Local lDupPath := .F. as Logical
    Local lJsonErr := .F. as Logical
    Local nVerb    := 0 as Numeric
    Local oSchStr    as Object
    Local oSchObj    as Object
    Local oSchArr    as Object
    Local oSchRef    as Object
    Local oSchBad    as Object
    Local oPropA     as Object
    Local oItemsSch  as Object
    Local oEmptyObj  as Object
    Local oEmptyArr  as Object
    Local oEmptyRef  as Object
    Local oNestObj   as Object
    Local oNestArr   as Object
    Local oNestChild as Object
    Local aProps    := {} as Array
    Local aSchPend  := {} as Array
    Local cKindErr  := "" as Character
    Local cPropErr  := "" as Character
    Local cItemsErr := "" as Character
    Local cRefErr   := "" as Character
    Local cMutErr   := "" as Character
    Local lKindErr  := .F. as Logical
    Local lPropErr  := .F. as Logical
    Local lItemsErr := .F. as Logical
    Local lRefErr   := .F. as Logical
    Local lMutErr   := .F. as Logical

    assertEquals(.T., .T., "O harness PROBAT deve aceitar valores iguais.")

    oInfo := OApiInfo():new(;
        "Hello World API",;
        "API de demonstra??o do n?cleo OpenAPI.",;
        "1.0.0";
    )

    assertEquals("Hello World API", oInfo:getTitle(), "O t?tulo deve ser preservado.")
    assertEquals("API de demonstra??o do n?cleo OpenAPI.", oInfo:getDesc(), "A descri??o deve ser preservada.")
    assertEquals("1.0.0", oInfo:getVer(), "A vers?o deve ser preservada.")

    aValid := oInfo:validate()
    assertEquals(0, Len(aValid), "Informa??es v?lidas n?o devem gerar pend?ncias.")

    oInv  := OApiInfo():new("", "Descri??o opcional.", "")
    aPend := oInv:validate()

    assertEquals(2, Len(aPend), "T?tulo e vers?o vazios devem gerar duas pend?ncias.")

    If Len(aPend) >= 2
        assertEquals("T?tulo da API ? obrigat?rio.", aPend[1], "A pend?ncia do t?tulo deve ocupar a primeira posi??o.")
        assertEquals("Vers?o da API ? obrigat?ria.", aPend[2], "A pend?ncia da vers?o deve ocupar a segunda posi??o.")
    EndIf

    oResp := OApiResp():new("200", "Resposta retornada com sucesso.")

    assertEquals("200", oResp:getCode(), "O c?digo da resposta deve ser preservado.")
    assertEquals("Resposta retornada com sucesso.", oResp:getDesc(), "A descri??o da resposta deve ser preservada.")

    aRValid := oResp:validate()
    assertEquals(0, Len(aRValid), "Resposta v?lida n?o deve gerar pend?ncias.")

    oRInv  := OApiResp():new("", "")
    aRPend := oRInv:validate()

    assertEquals(2, Len(aRPend), "C?digo e descri??o vazios devem gerar duas pend?ncias.")

    If Len(aRPend) >= 2
        assertEquals("C?digo da resposta ? obrigat?rio.", aRPend[1], "A pend?ncia do c?digo deve ocupar a primeira posi??o.")
        assertEquals("Descri??o da resposta ? obrigat?ria.", aRPend[2], "A pend?ncia da descri??o deve ocupar a segunda posi??o.")
    EndIf

    oOper := OApiOper():new(;
        "GET",;
        "Retorna a sauda??o",;
        "Retorna a resposta Hello World.";
    )

    assertEquals("get", oOper:getMethod(), "O verbo suportado deve ser normalizado para min?sculas.")
    assertEquals("Retorna a sauda??o", oOper:getSummary(), "O resumo da opera??o deve ser preservado.")
    assertEquals("Retorna a resposta Hello World.", oOper:getDesc(), "A descri??o da opera??o deve ser preservada.")

    For nVerb := 1 To Len(aVerbs)
        oVerb := OApiOper():new(aVerbs[nVerb][1], "Opera??o de teste", "Valida um verbo OpenAPI.")
        assertEquals(aVerbs[nVerb][2], oVerb:getMethod(), "O verbo " + aVerbs[nVerb][1] + " deve ser aceito e normalizado.")
    Next nVerb

    oOper:addResp(oResp)
    aResps := oOper:getResps()

    assertEquals(1, Len(aResps), "A resposta 200 deve ser inclu?da na opera??o.")
    If Len(aResps) >= 1
        assertEquals("200", aResps[1]:getCode(), "O c?digo da resposta inclu?da deve ser preservado.")
        assertEquals("Resposta retornada com sucesso.", aResps[1]:getDesc(), "A resposta original deve ser preservada.")
    EndIf
    oNextRsp := OApiResp():new("201", "Recurso criado com sucesso.")
    AAdd(aResps, oNextRsp)
    assertEquals(2, Len(aResps), "O array retornado deve aceitar altera??o externa isolada.")

    aResps := oOper:getResps()
    assertEquals(1, Len(aResps), "A altera??o externa n?o deve modificar as respostas internas.")
    If Len(aResps) >= 1
        assertEquals("200", aResps[1]:getCode(), "Uma nova consulta deve preservar somente a resposta interna.")
    EndIf

    assertEquals(0, Len(oOper:validate()), "Opera??o com resposta v?lida n?o deve gerar pend?ncias.")

    oNoResp := OApiOper():new("POST", "Cria um recurso", "Cria um recurso de teste.")
    aOPend := oNoResp:validate()

    assertEquals(1, Len(aOPend), "Opera??o sem respostas deve gerar uma pend?ncia.")
    If Len(aOPend) >= 1
        assertEquals("Opera??o post sem respostas.", aOPend[1], "A pend?ncia deve identificar o verbo normalizado.")
    EndIf

    Try
        oNoResp := OApiOper():new("CONNECT", "Verbo inv?lido", "N?o deve ser criado.")
    Catch oError
        lBadVerb := .T.
        cBadVerb := oError:Description
    EndTry

    assertEquals(.T., lBadVerb, "Verbo desconhecido deve falhar imediatamente.")
    assertEquals("Verbo OpenAPI n?o suportado: CONNECT.", cBadVerb, "O erro deve diagnosticar o verbo desconhecido.")

    oDupResp := OApiResp():new("200", "Resposta que n?o deve substituir a original.")

    Try
        oOper:addResp(oDupResp)
    Catch oError
        lDupErr := .T.
        cDupErr := oError:Description
    EndTry

    assertEquals(.T., lDupErr, "Resposta duplicada deve falhar imediatamente.")
    assertEquals("Resposta duplicada: 200.", cDupErr, "O erro deve diagnosticar o c?digo duplicado.")

    aResps := oOper:getResps()
    assertEquals(1, Len(aResps), "A falha n?o deve incluir nem substituir a resposta original.")
    If Len(aResps) >= 1
        assertEquals("Resposta retornada com sucesso.", aResps[1]:getDesc(), "A resposta original deve permanecer inalterada.")
    EndIf

    oOper:addResp(oNextRsp)
    aResps := oOper:getResps()

    assertEquals(2, Len(aResps), "A opera??o deve continuar utiliz?vel ap?s a inclus?o rejeitada.")
    If Len(aResps) >= 2
        assertEquals("201", aResps[2]:getCode(), "Uma nova resposta v?lida deve ser aceita ap?s a falha.")
    EndIf

    oPath := OApiPath():new("/api/v1/hello")
    assertEquals("/api/v1/hello", oPath:getPath(), "O path deve ser preservado.")

    oPath:addOper(oOper)
    aOpers := oPath:getOpers()

    assertEquals(1, Len(aOpers), "A opera??o GET v?lida deve ser inclu?da no path.")
    If Len(aOpers) >= 1
        assertEquals("get", aOpers[1]:getMethod(), "O verbo da opera??o inclu?da deve ser preservado.")
        assertEquals("Retorna a sauda??o", aOpers[1]:getSummary(), "O resumo da primeira opera??o deve ser preservado.")
    EndIf

    oDupOper := OApiOper():new("GET", "Resumo duplicado", "N?o deve substituir a opera??o original.")
    AAdd(aOpers, oDupOper)
    assertEquals(2, Len(aOpers), "O array retornado deve aceitar altera??o externa isolada.")

    aOpers := oPath:getOpers()
    assertEquals(1, Len(aOpers), "A altera??o externa n?o deve modificar as opera??es internas.")

    Try
        oBadPath := OApiPath():new("api/v1/hello")
    Catch oError
        lPathErr := .T.
        cPathErr := oError:Description
    EndTry

    assertEquals(.T., lPathErr, "Path sem barra inicial deve falhar imediatamente.")
    assertEquals("Path OpenAPI inv?lido: api/v1/hello.", cPathErr, "O erro deve diagnosticar o path inv?lido.")

    Try
        oPath:addOper(oDupOper)
    Catch oError
        lDupOper := .T.
        cDupOper := oError:Description
    EndTry

    assertEquals(.T., lDupOper, "Verbo duplicado no mesmo path deve falhar imediatamente.")
    assertEquals("Opera??o duplicada no path /api/v1/hello: get.", cDupOper, "O erro deve identificar o path e o verbo duplicado.")

    aOpers := oPath:getOpers()
    assertEquals(1, Len(aOpers), "A falha n?o deve incluir nem substituir a opera??o original.")
    If Len(aOpers) >= 1
        assertEquals("Retorna a sauda??o", aOpers[1]:getSummary(), "A opera??o original deve permanecer inalterada.")
    EndIf

    oPost := OApiOper():new("POST", "Cria uma sauda??o", "Cria uma nova sauda??o.")
    oPostRsp := OApiResp():new("201", "Sauda??o criada com sucesso.")
    oPost:addResp(oPostRsp)
    oPath:addOper(oPost)
    aOpers := oPath:getOpers()

    assertEquals(2, Len(aOpers), "O path deve continuar utiliz?vel ap?s a inclus?o rejeitada.")
    If Len(aOpers) >= 2
        assertEquals("post", aOpers[2]:getMethod(), "Uma nova opera??o v?lida deve ser aceita ap?s a falha.")
    EndIf

    assertEquals(0, Len(oPath:validate()), "Path com opera??es v?lidas n?o deve gerar pend?ncias.")

    oPendP := OApiPath():new("/api/v1/pending")
    oPendOp := OApiOper():new("POST", "Opera??o pendente", "Opera??o sem resposta.")
    oPendP:addOper(oPendOp)
    aPPend := oPendP:validate()

    assertEquals(1, Len(aPPend), "Path com opera??o incompleta deve agregar uma pend?ncia.")
    If Len(aPPend) >= 1
        assertEquals("Path /api/v1/pending: Opera??o post sem respostas.", aPPend[1], "A pend?ncia deve identificar o path e o verbo.")
    EndIf

    oDoc := OApiDoc():new(oInfo)

    assertEquals("3.0.3", oDoc:getOpenApi(), "A vers?o OpenAPI deve ser fixa em 3.0.3.")
    assertEquals("Hello World API", oDoc:getInfo():getTitle(), "As informa??es v?lidas devem ser preservadas no documento.")
    assertEquals("1.0.0", oDoc:getInfo():getVer(), "A vers?o da API deve ser preservada no documento.")

    oDoc:addPath(oPath)
    aPaths := oDoc:getPaths()

    assertEquals(1, Len(aPaths), "O path Hello World completo deve ser inclu?do no documento.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "O path inclu?do deve ser preservado.")
    EndIf

    AAdd(aPaths, oPendP)
    assertEquals(2, Len(aPaths), "O array retornado deve aceitar altera??o externa isolada.")

    aPaths := oDoc:getPaths()
    assertEquals(1, Len(aPaths), "A altera??o externa n?o deve modificar os paths internos.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "Uma nova consulta deve preservar somente o path interno.")
    EndIf

    oDupPath := OApiPath():new("/api/v1/hello")

    Try
        oDoc:addPath(oDupPath)
    Catch oError
        lDupPath := .T.
        cDupPath := oError:Description
    EndTry

    assertEquals(.T., lDupPath, "Path duplicado no documento deve falhar imediatamente.")
    assertEquals("Path duplicado no documento: /api/v1/hello.", cDupPath, "O erro deve identificar o path duplicado.")

    aPaths := oDoc:getPaths()
    assertEquals(1, Len(aPaths), "A falha n?o deve incluir nem substituir o path original.")
    If Len(aPaths) >= 1
        assertEquals("/api/v1/hello", aPaths[1]:getPath(), "O path original deve permanecer inalterado.")
    EndIf

    oUniPath := OApiPath():new("/api/v1/unique")
    oUniOper := OApiOper():new("GET", "Consulta ?nica", "Consulta um recurso ?nico.")
    oUniResp := OApiResp():new("200", "Recurso ?nico retornado com sucesso.")
    oUniOper:addResp(oUniResp)
    oUniPath:addOper(oUniOper)
    oDoc:addPath(oUniPath)
    aPaths := oDoc:getPaths()

    assertEquals(2, Len(aPaths), "O documento deve continuar utiliz?vel ap?s a inclus?o rejeitada.")
    If Len(aPaths) >= 2
        assertEquals("/api/v1/unique", aPaths[2]:getPath(), "Um path ?nico deve ser aceito ap?s a falha.")
    EndIf

    aDValid := oDoc:validate()
    assertEquals(0, Len(aDValid), "Documento v?lido n?o deve gerar pend?ncias.")

    oBadInfo := OApiInfo():new("", "", "")
    oBadDoc := OApiDoc():new(oBadInfo)
    aDInv := oBadDoc:validate()

    assertEquals(3, Len(aDInv), "Informa??es inv?lidas e aus?ncia de paths devem gerar tr?s pend?ncias.")
    If Len(aDInv) >= 3
        assertEquals("T?tulo da API ? obrigat?rio.", aDInv[1], "A pend?ncia do t?tulo deve ocupar a primeira posi??o.")
        assertEquals("Vers?o da API ? obrigat?ria.", aDInv[2], "A pend?ncia da vers?o deve ocupar a segunda posi??o.")
        assertEquals("Documento OpenAPI deve possuir ao menos um path.", aDInv[3], "A aus?ncia de paths deve ocupar a terceira posi??o.")
    EndIf

    oPendDoc := OApiDoc():new(oInfo)
    oPendDoc:addPath(oPendP)
    aDPend := oPendDoc:validate()

    assertEquals(1, Len(aDPend), "Documento com path incompleto deve agregar uma pend?ncia.")
    If Len(aDPend) >= 1
        assertEquals("Path /api/v1/pending: Opera??o post sem respostas.", aDPend[1], "A pend?ncia do path deve manter o contexto no documento.")
    EndIf

    oInvResp := OApiResp():new("", "")
    oInvOper := OApiOper():new("GET", "Resposta inv?lida", "Valida pend?ncias transitivas.")
    oInvOper:addResp(oInvResp)
    oInvPath := OApiPath():new("/api/v1/invalid")
    oInvPath:addOper(oInvOper)
    oInvDoc := OApiDoc():new(oInfo)
    oInvDoc:addPath(oInvPath)
    aInvPend := oInvDoc:validate()

    assertEquals(2, Len(aInvPend), "Documento deve agregar as duas pend?ncias da resposta inv?lida.")
    If Len(aInvPend) >= 2
        assertEquals("Path /api/v1/invalid: Opera??o get, resposta <vazio>: C?digo da resposta ? obrigat?rio.", aInvPend[1], "A primeira pend?ncia deve manter o contexto completo da resposta.")
        assertEquals("Path /api/v1/invalid: Opera??o get, resposta <vazio>: Descri??o da resposta ? obrigat?ria.", aInvPend[2], "A segunda pend?ncia deve manter o contexto completo da resposta.")
    EndIf

    oMultiDoc := OApiDoc():new(oInfo)
    oMultiDoc:addPath(oPendP)
    oMultiDoc:addPath(oInvPath)
    aMulti := oMultiDoc:validate()

    assertEquals(3, Len(aMulti), "Documento deve agregar pend?ncias de todos os paths em ordem.")
    If Len(aMulti) >= 3
        assertEquals("Path /api/v1/pending: Opera??o post sem respostas.", aMulti[1], "A pend?ncia do primeiro path deve ocupar a primeira posi??o.")
        assertEquals("Path /api/v1/invalid: Opera??o get, resposta <vazio>: C?digo da resposta ? obrigat?rio.", aMulti[2], "A primeira pend?ncia do segundo path deve ocupar a segunda posi??o.")
        assertEquals("Path /api/v1/invalid: Opera??o get, resposta <vazio>: Descri??o da resposta ? obrigat?ria.", aMulti[3], "A segunda pend?ncia do segundo path deve ocupar a terceira posi??o.")
    EndIf

    oJson := OApiJson():new()

    Try
        cJson := oJson:toJson(oBadDoc)
    Catch oError
        lJsonErr := .T.
        cJsonErr := oError:Description
    EndTry

    assertEquals(.T., lJsonErr, "Documento incompleto deve ser rejeitado antes da serializa??o.")
    assertEquals("Documento OpenAPI inv?lido: T?tulo da API ? obrigat?rio. | Vers?o da API ? obrigat?ria. | Documento OpenAPI deve possuir ao menos um path.", cJsonErr, "O erro deve agregar todas as pend?ncias sem dados de ambiente.")
    assertEquals("", cJson, "Falha de valida??o n?o deve retornar JSON parcial.")

    oJInfo := OApiInfo():new(;
        "Hello World API",;
        "API de demonstra??o do n?cleo OpenAPI.",;
        "1.0.0";
    )
    oJResp := OApiResp():new("200", "Hello World retornado com sucesso.")
    oJBad := OApiResp():new("400", "Requisi??o inv?lida.")
    oJOper := OApiOper():new(;
        "GET",;
        "Hello World",;
        "Retorna uma mensagem Hello World gerada por um endpoint TL++.";
    )
    oJOper:addResp(oJResp)
    oJOper:addResp(oJBad)
    oJPost := OApiOper():new("POST", "Cria sauda??o", "Cria uma nova sauda??o.")
    oJPResp := OApiResp():new("201", "Sauda??o criada com sucesso.")
    oJPost:addResp(oJPResp)
    oJPath := OApiPath():new("/api/v1/hello")
    oJPath:addOper(oJOper)
    oJPath:addOper(oJPost)
    oJStat := OApiPath():new("/api/v1/status")
    oJSOper := OApiOper():new("GET", "Consulta status", "Retorna o status da API.")
    oJSResp := OApiResp():new("200", "Status retornado com sucesso.")
    oJSOper:addResp(oJSResp)
    oJStat:addOper(oJSOper)
    oDoc := OApiDoc():new(oJInfo)
    oDoc:addPath(oJPath)
    oDoc:addPath(oJStat)

    cJson := oJson:toJson(oDoc)
    assertEquals("C", ValType(cJson), "A serializa??o v?lida deve retornar character.")
    assertEquals(.F., Empty(cJson), "A serializa??o v?lida deve retornar conte?do JSON.")

    jParsed := JsonObject():New()
    cParse := jParsed:FromJson(cJson)
    assertEquals(.T., Empty(cParse), "O JSON produzido deve ser aceito por JsonObject:FromJson().")

    If Empty(cParse)
        assertEquals("3.0.3", jParsed["openapi"], "O JSON deve preservar a vers?o OpenAPI.")
        assertEquals("Hello World API", jParsed["info"]["title"], "O JSON deve preservar o t?tulo da API.")
        assertEquals("API de demonstra??o do n?cleo OpenAPI.", jParsed["info"]["description"], "O JSON deve preservar a descri??o da API.")
        assertEquals("1.0.0", jParsed["info"]["version"], "O JSON deve preservar a vers?o da API.")
        assertEquals("Hello World", jParsed["paths"]["/api/v1/hello"]["get"]["summary"], "O JSON deve preservar o resumo da opera??o GET.")
        assertEquals("Retorna uma mensagem Hello World gerada por um endpoint TL++.", jParsed["paths"]["/api/v1/hello"]["get"]["description"], "O JSON deve preservar a descri??o da opera??o GET.")
        assertEquals("Hello World retornado com sucesso.", jParsed["paths"]["/api/v1/hello"]["get"]["responses"]["200"]["description"], "O JSON deve preservar a descri??o da resposta 200.")
        assertEquals("Requisi??o inv?lida.", jParsed["paths"]["/api/v1/hello"]["get"]["responses"]["400"]["description"], "O JSON deve preservar a segunda resposta da opera??o GET.")
        assertEquals("Cria sauda??o", jParsed["paths"]["/api/v1/hello"]["post"]["summary"], "O JSON deve preservar a segunda opera??o do path Hello World.")
        assertEquals("Sauda??o criada com sucesso.", jParsed["paths"]["/api/v1/hello"]["post"]["responses"]["201"]["description"], "O JSON deve preservar a resposta 201 da opera??o POST.")
        assertEquals("Consulta status", jParsed["paths"]["/api/v1/status"]["get"]["summary"], "O JSON deve preservar a opera??o GET do segundo path.")
        assertEquals("Status retornado com sucesso.", jParsed["paths"]["/api/v1/status"]["get"]["responses"]["200"]["description"], "O JSON deve preservar a resposta 200 do segundo path.")
    EndIf

    oSchStr := OApiSchema():new("string")
    assertEquals("string", oSchStr:getKind(), "O discriminante string deve ser preservado.")
    assertEquals(0, Len(oSchStr:validate()), "Schema primitivo não deve gerar pendências.")

    Try
        oSchBad := OApiSchema():new("unknown")
    Catch oError
        lKindErr := .T.
        cKindErr := oError:Description
    EndTry

    assertEquals(.T., lKindErr, "Discriminante desconhecido deve falhar imediatamente.")
    assertEquals("Tipo de schema OpenAPI não suportado: unknown.", cKindErr, "O erro deve diagnosticar o discriminante desconhecido.")

    oSchObj := OApiSchema():new("Object")
    assertEquals("object", oSchObj:getKind(), "O discriminante object deve ser normalizado para minúsculas.")

    oPropA := OApiSchema():new("string")
    oSchObj:addProp("name", oPropA, .T.)
    aProps := oSchObj:getProps()

    assertEquals(1, Len(aProps), "A propriedade válida deve ser incluída no schema object.")
    If Len(aProps) >= 1
        assertEquals("name", aProps[1][1], "O nome da propriedade deve ser preservado.")
        assertEquals("string", aProps[1][2]:getKind(), "O schema da propriedade deve ser preservado.")
        assertEquals(.T., aProps[1][3], "A obrigatoriedade da propriedade deve ser preservada.")
    EndIf

    assertEquals(0, Len(oSchObj:validate()), "Schema object com propriedade válida não deve gerar pendências.")

    Try
        oSchObj:addProp("name", oPropA, .F.)
    Catch oError
        lPropErr := .T.
        cPropErr := oError:Description
    EndTry

    assertEquals(.T., lPropErr, "Propriedade duplicada deve falhar imediatamente.")
    assertEquals("Propriedade duplicada: name.", cPropErr, "O erro deve diagnosticar a propriedade duplicada.")

    aProps := oSchObj:getProps()
    assertEquals(1, Len(aProps), "A falha não deve incluir nem substituir a propriedade original.")

    Try
        oSchStr:addProp("x", oPropA, .T.)
    Catch oError
        lMutErr := .T.
        cMutErr := oError:Description
    EndTry

    assertEquals(.T., lMutErr, "addProp() em schema não object deve falhar imediatamente.")
    assertEquals("addProp() disponível somente para schemas do tipo object.", cMutErr, "O erro deve identificar o mutador incompatível.")

    oEmptyObj := OApiSchema():new("object")
    aSchPend := oEmptyObj:validate()

    assertEquals(1, Len(aSchPend), "Schema object sem propriedades deve gerar uma pendência.")
    If Len(aSchPend) >= 1
        assertEquals("Schema object sem propriedades.", aSchPend[1], "A pendência deve identificar a ausência de propriedades.")
    EndIf

    oSchArr := OApiSchema():new("array")
    oItemsSch := OApiSchema():new("integer")
    oSchArr:setItems(oItemsSch)

    assertEquals("integer", oSchArr:getItems():getKind(), "O schema dos items deve ser preservado.")
    assertEquals(0, Len(oSchArr:validate()), "Schema array com items válido não deve gerar pendências.")

    lMutErr := .F.

    Try
        oSchArr:setItems(oItemsSch)
    Catch oError
        lItemsErr := .T.
        cItemsErr := oError:Description
    EndTry

    assertEquals(.T., lItemsErr, "Uma segunda definição de items deve falhar imediatamente.")
    assertEquals("Items do schema array já definidos.", cItemsErr, "O erro deve diagnosticar a redefinição dos items.")

    Try
        oSchStr:setItems(oItemsSch)
    Catch oError
        lMutErr := .T.
        cMutErr := oError:Description
    EndTry

    assertEquals(.T., lMutErr, "setItems() em schema não array deve falhar imediatamente.")
    assertEquals("setItems() disponível somente para schemas do tipo array.", cMutErr, "O erro deve identificar o mutador incompatível.")

    oEmptyArr := OApiSchema():new("array")
    aSchPend := oEmptyArr:validate()

    assertEquals(1, Len(aSchPend), "Schema array sem items deve gerar uma pendência.")
    If Len(aSchPend) >= 1
        assertEquals("Schema array sem items.", aSchPend[1], "A pendência deve identificar a ausência de items.")
    EndIf

    oSchRef := OApiSchema():new("ref")
    oSchRef:setRef("HelloResponse")

    assertEquals("HelloResponse", oSchRef:getRef(), "O nome referenciado deve ser preservado.")
    assertEquals(0, Len(oSchRef:validate()), "Schema ref com nome válido não deve gerar pendências.")

    Try
        oSchRef:setRef("Other")
    Catch oError
        lRefErr := .T.
        cRefErr := oError:Description
    EndTry

    assertEquals(.T., lRefErr, "Uma segunda definição de referência deve falhar imediatamente.")
    assertEquals("Referência do schema já definida.", cRefErr, "O erro deve diagnosticar a redefinição da referência.")

    lRefErr := .F.

    Try
        oEmptyRef := OApiSchema():new("ref")
        oEmptyRef:setRef("Invalid Name!")
    Catch oError
        lRefErr := .T.
        cRefErr := oError:Description
    EndTry

    assertEquals(.T., lRefErr, "Nome de referência inválido deve falhar imediatamente.")
    assertEquals("Nome de referência OpenAPI inválido: Invalid Name!.", cRefErr, "O erro deve diagnosticar o nome inválido.")

    lMutErr := .F.

    Try
        oSchStr:setRef("Foo")
    Catch oError
        lMutErr := .T.
        cMutErr := oError:Description
    EndTry

    assertEquals(.T., lMutErr, "setRef() em schema não ref deve falhar imediatamente.")
    assertEquals("setRef() disponível somente para schemas do tipo ref.", cMutErr, "O erro deve identificar o mutador incompatível.")

    oEmptyRef := OApiSchema():new("ref")
    aSchPend := oEmptyRef:validate()

    assertEquals(1, Len(aSchPend), "Schema ref sem nome deve gerar uma pendência.")
    If Len(aSchPend) >= 1
        assertEquals("Schema ref sem nome.", aSchPend[1], "A pendência deve identificar a ausência do nome referenciado.")
    EndIf

    oNestObj := OApiSchema():new("object")
    oNestChild := OApiSchema():new("object")
    oNestObj:addProp("child", oNestChild, .T.)
    aSchPend := oNestObj:validate()

    assertEquals(1, Len(aSchPend), "Pendência de propriedade aninhada deve ser propagada.")
    If Len(aSchPend) >= 1
        assertEquals("Propriedade child: Schema object sem propriedades.", aSchPend[1], "A pendência deve manter o contexto da propriedade.")
    EndIf

    oNestArr := OApiSchema():new("array")
    oNestArr:setItems(OApiSchema():new("array"))
    aSchPend := oNestArr:validate()

    assertEquals(1, Len(aSchPend), "Pendência de items aninhados deve ser propagada.")
    If Len(aSchPend) >= 1
        assertEquals("Item: Schema array sem items.", aSchPend[1], "A pendência deve manter o contexto do item.")
    EndIf

Return .T.
