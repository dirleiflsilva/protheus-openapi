#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
Spike: o spike anterior (inspect2) revelou o layout exato retornado por
Reflection.getFunctionsByAnnotation('Get') - cada item e [cSourceName, cFunctionName], com
cSourceName em maiusculas com extensao (ex.: "CUSTOM.OPENAPI.HELLO.GET.TLPP") e cFunctionName
com o prefixo interno U_ tambem em maiusculas (ex.: "U_HELOGET"). Este fonte reusa exatamente
esses valores reais (nao mais um palpite) para chamar isAnnotationFunctionPresent e
getFunctionAnnotation sobre HeloGet, e dumpa o ValType/conteudo do retorno desta ultima.
@type function
@author Dirlei Silva
@since 2026-09-25
@return logical, Resultado do envio da resposta REST
*/
@Get(;
    endpoint="/api/v1/openapi/spike/inspect3",;
    title="Spike Reflection - annotation real de HeloGet",;
    description="Usa cSourceName/cFunctionName reais (vindos de getFunctionsByAnnotation) para ler a annotation @Get de HeloGet.";
)
User Function TlaSpkIn3() as Logical

    Local cSource   := "CUSTOM.OPENAPI.HELLO.GET.TLPP" as Character
    Local cFunc     := "U_HELOGET" as Character
    Local jResp     := JsonObject():New() as Json
    Local cResp     := "" as Character
    Local lOk       := .F. as Logical
    Local cErro     := "" as Character
    Local lPresente := .F. as Logical
    Local xAnot     as Variant
    Local cValType  := "" as Character
    Local aPos      := {} as Array
    Local jPos      := JsonObject():New() as Json
    Local nJ        := 0 as Numeric
    Local xValor    as Variant

    Try
        lPresente := Reflection.isAnnotationFunctionPresent(cSource, cFunc, "Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["presentSuccess"] := lOk
    If lOk
        jResp["present"] := lPresente
    Else
        jResp["presentError"] := cErro
    EndIf

    lOk   := .F.
    cErro := ""

    Try
        xAnot := Reflection.getFunctionAnnotation(cSource, cFunc, "Get")
        lOk := .T.
    Catch oException
        lOk := .F.
        cErro := oException:description
    EndTry

    jResp["annotationSuccess"] := lOk

    If !lOk
        jResp["annotationError"] := cErro
        cResp := jResp:ToJson()
        oRest:SetStatusCode(200)
        oRest:SetKeyHeaderResponse("Content-Type", "application/json")
        Return oRest:SetResponse(cResp)
    EndIf

    cValType := ValType(xAnot)
    jResp["annotationValType"] := cValType

    If cValType == "C" .Or. cValType == "N" .Or. cValType == "L"
        jResp["annotationValue"] := xAnot

    ElseIf cValType == "O"
        Try
            jResp["annotationClassName"] := xAnot:ClassName()
        Catch oException
            jResp["annotationClassNameError"] := oException:description
        EndTry

    ElseIf cValType == "A"
        jResp["annotationArrayLen"] := Len(xAnot)

        For nJ := 1 To Len(xAnot)
            xValor := xAnot[nJ]

            jPos := JsonObject():New()
            jPos["position"] := nJ
            jPos["valType"]  := ValType(xValor)

            If ValType(xValor) == "C" .Or. ValType(xValor) == "N" .Or. ValType(xValor) == "L"
                jPos["value"] := xValor
            ElseIf ValType(xValor) == "O"
                Try
                    jPos["className"] := xValor:ClassName()
                Catch oException
                    jPos["classNameError"] := oException:description
                EndTry
            EndIf

            AAdd(aPos, jPos)
        Next nJ

        jResp["annotationPositions"] := aPos

    ElseIf cValType == "J"
        jResp["annotationJson"] := xAnot
    EndIf

    cResp := jResp:ToJson()

    oRest:SetStatusCode(200)
    oRest:SetKeyHeaderResponse("Content-Type", "application/json")

Return oRest:SetResponse(cResp)
